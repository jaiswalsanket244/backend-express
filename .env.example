# ---------------------------------------------------------------------------
# Backend (auth module) environment variables.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# Core server
PORT=4000
# SQLite connection string. Relative paths are resolved from the prisma/ dir.
DATABASE_URL="file:./dev.db"
# Frontend origin allowed by CORS (credentials enabled).
FRONTEND_URL=http://localhost:3000

# JWT — use long, random secrets in production.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# OAuth — Google (placeholders; wired up in a later sub-issue)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/oauth/google/callback

# OAuth — Microsoft (placeholders)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:4000/api/auth/oauth/microsoft/callback
MICROSOFT_TENANT=common

# OAuth — Apple (placeholders)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:4000/api/auth/oauth/apple/callback
